# ============================================================
# .env.example
# Copie este arquivo para .env e preencha com seus valores
# NUNCA commite o arquivo .env no controle de versão!
# ============================================================

# --- Banco de Dados ---
# Caminho do arquivo SQLite (relativo à pasta backend/)
DATABASE_URL=sqlite:///./quimiochat.db

# --- JWT (JSON Web Token) ---
# Chave secreta para assinar os tokens — use uma string aleatória longa!
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_ESTA_CHAVE_EM_PRODUCAO_USE_STRING_ALEATORIA_LONGA

# Algoritmo de assinatura do JWT
ALGORITHM=HS256

# Tempo de expiração do token em minutos (padrão: 60 = 1 hora)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Ollama (IA Local) ---
# URL base do servidor Ollama (padrão local)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo a ser usado (gemma2 = padrão do TCC)
OLLAMA_MODEL=gemma2

# Timeout em segundos para o Ollama responder
OLLAMA_TIMEOUT=120

# --- Servidor FastAPI ---
# Host e porta para o uvicorn (use 0.0.0.0 para acesso externo)
API_HOST=127.0.0.1
API_PORT=8000
